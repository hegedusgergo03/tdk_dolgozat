  prevalencia       = colMeans(modell$theta),
  koherencia        = semanticCoherence(modell, stm_adatok$documents),
  exkluzivitas      = exclusivity(modell),
  highest_prob      = apply(szavak$prob, 1, paste, collapse = ", "),
  frex              = apply(szavak$frex, 1, paste, collapse = ", "),
  cimke             = ""            # a kézi topikcímkéket ide kell beírni
)
fwrite(topik_tabla, utvonal("topikok_szavak.csv"), bom = TRUE)

png(utvonal("topikok_megoszlasa.png"), width = 2000, height = 1400, res = 150)
plot(modell, type = "summary", n = 5, main = "Témák megoszlása a korpuszban")
dev.off()

# Topikonként 5 jellemző dokumentum a címkézéshez (minden topikra)
cimkezo_dokumentumok <- rbindlist(lapply(seq_len(VEGSO_K), function(k) {
  sorrend <- order(modell$theta[, k], decreasing = TRUE)[1:5]
  data.table(topik = k, id = meta$id[sorrend], theta = modell$theta[sorrend, k])
}))
cimkezo_dokumentumok <- merge(cimkezo_dokumentumok,
