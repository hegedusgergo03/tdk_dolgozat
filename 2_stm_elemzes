######################################################################
#10. Reprezentatív dokumentumok a CDA-hoz (rétegzett kiválasztás)    #
######################################################################

# Topikonként és időszakonként a legmagasabb theta-értékű, legalább CDA_MIN_SZO
# hosszú dokumentumok. Így a CDA a 3. kutatási kérdéshez (időbeli változás) is
# ad anyagot, és nem csak a csúcsidőszak szövegeit elemezzük.
meta[, idoszak := IDOSZAKOK$idoszak[findInterval(as.Date(datum_num, origin = "1970-01-01"),
                                                 IDOSZAKOK$kezdet)]]
meta[, sor := .I]

cda_minta <- rbindlist(lapply(VIZSGALT_TOPIKOK, function(k) {
  jelolt <- meta[szoszam >= CDA_MIN_SZO, .(sor, id, idoszak, forras, domain, link, datum_num)]
  jelolt[, theta := modell$theta[sor, k]]
  jelolt[, topik := k]
  jelolt[order(-theta), head(.SD, CDA_DOK_PER_CELLA), by = idoszak]
}))
cda_minta[, datum := as.Date(datum_num, origin = "1970-01-01")]

# Kiegészítésként forrás szerinti bontás is (hírportál vs. közösségi média):
# a bizalmatlanság/ellen-magatartás összevetéséhez (2. kutatási kérdés)
cda_forras <- rbindlist(lapply(VIZSGALT_TOPIKOK, function(k) {
  jelolt <- meta[szoszam >= CDA_MIN_SZO, .(sor, id, idoszak, forras, domain, link, datum_num)]
  jelolt[, theta := modell$theta[sor, k]]
  jelolt[, topik := k]
  jelolt[order(-theta), head(.SD, CDA_DOK_PER_CELLA), by = forras]
}))

# A két minta szövegei egyetlen betöltéssel
cda_szovegek <- szovegek_betolt(unique(c(cda_minta$id, cda_forras$id)))

cda_minta <- merge(cda_minta, cda_szovegek, by = "id", sort = FALSE)
setorder(cda_minta, topik, idoszak, -theta)
fwrite(cda_minta[, .(topik, idoszak, datum, forras, domain, theta, link, id, szoveg)],
       utvonal("cda_minta_retegzett.csv"), bom = TRUE)

cda_forras <- merge(cda_forras, cda_szovegek, by = "id", sort = FALSE)
setorder(cda_forras, topik, forras, -theta)
fwrite(cda_forras[, .(topik, forras, idoszak, datum = as.Date(datum_num, origin = "1970-01-01"),
                      domain, theta, link, id, szoveg)],
       utvonal("cda_minta_forras_szerint.csv"), bom = TRUE)
rm(cda_szovegek); gc()

