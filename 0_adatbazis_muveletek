# 3.3 Duplikátumszűrés.
# Normalizált alak: kisbetű, csak betűk és számok, egyszeres szóközök. Így a
# központozásban/szóközökben eltérő másolatok is egyezőnek számítanak.
# A normalizált szöveget darabonként számoljuk, és csak a szószámot és a
# duplikátumkulcsot (az első PREFIX_HOSSZ karaktert) tartjuk meg belőle.
normalizal <- function(x) {
  x <- stri_trans_tolower(x)
  x <- stri_replace_all_regex(x, "https?://\\S+|www\\.\\S+", " ")
  x <- stri_replace_all_regex(x, "[^\\p{L}\\p{N}]+", " ")
  stri_trim_both(x)
}

adat[, `:=`(szoszam = NA_integer_, dup_kulcs = NA_character_)]
