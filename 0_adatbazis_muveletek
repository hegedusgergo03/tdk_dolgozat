# mert az már korpusz-specifikus szűrés lenne (Schofield és mtsai., 2017).
KIEGESZITO_STOP_HU <- c("is", "ha", "miatt", "illetve", "sem", "pl", "stb")

# Árva ragtöredékek: a SentiOne-export a számokat és a kötőjeleket már eleve
