# Szöveg tördelése a cella szélességéhez (szavanként, a tényleges betűszélesség alapján)
tordel_szoveg <- function(szoveg, szelesseg, cex, font) {
  szavak <- strsplit(szoveg, " ", fixed = TRUE)[[1]]
  sorok <- character(0)
  aktualis <- ""
  for (szo in szavak) {
    proba <- if (aktualis == "") szo else paste(aktualis, szo)
    if (aktualis != "" && strwidth(proba, cex = cex, font = font) > szelesseg) {
      sorok <- c(sorok, aktualis)
      aktualis <- szo
    } else {
      aktualis <- proba
    }
  }
  c(sorok, aktualis)
}

kodkonyv_tablazat <- function(fajlnev, dimenzio, sorok) {
  oszlop_x <- c(0, 1.75, 4.25, 6.85, 10)   # oszlophatárok
  margo    <- 0.12                         # belső margó a cellákban
  cex      <- 0.62
  fontok   <- c(2, 1, 1, 3)                # kód félkövér, példa dőlt
  fejlec   <- c("Kód", "Definíció", "Nyelvi indikátorok", "Példa a korpuszból")

  # 1. Méretezés egy ideiglenes, a végső képpel azonos felbontású és betűtípusú eszközön
  png(tempfile(fileext = ".png"), width = 2520, height = 2520, res = 400)
  par(mar = c(0.2, 0.2, 0.2, 0.2), family = "serif")
  plot(NULL, xlim = c(0, 10), ylim = c(0, 10), axes = FALSE, xlab = "", ylab = "")
  sor_lepes <- strheight("ÁÉgy", cex = cex) * 1.75
  cellak <- lapply(sorok, function(s) lapply(1:4, function(j)
    tordel_szoveg(s[j], oszlop_x[j + 1] - oszlop_x[j] - 2 * margo, cex, fontok[j])))
  dev.off()

  sor_magassag <- sapply(cellak, function(c) max(lengths(c)) * sor_lepes + 2 * margo)
  cim_mag   <- 0.70
  fej_mag   <- 0.55
  H <- 0.10 + cim_mag + fej_mag + sum(sor_magassag) + 0.10

  # 2. Rajzolás
  png(fajlnev, width = 2520, height = round(2520 * H / 10), res = 400)
  par(mar = c(0.2, 0.2, 0.2, 0.2), family = "serif")
  plot(NULL, xlim = c(0, 10), ylim = c(0, H), axes = FALSE, xlab = "", ylab = "")

  y <- H - 0.10

  # Dimenzió címsora
  rect(0, y - cim_mag, 10, y, col = "#DCE8F7", border = NA)
  text(0.25, y - cim_mag / 2, dimenzio, font = 2, cex = 0.90, adj = c(0, 0.5))
  segments(0, y, 10, y, col = "black", lwd = 3.5)
  y <- y - cim_mag

  # Fejléc
  rect(0, y - fej_mag, 10, y, col = "#EAEFF5", border = NA)
  for (j in 1:4) text(oszlop_x[j] + margo, y - fej_mag / 2, fejlec[j], font = 2, cex = 0.72, adj = c(0, 0.5))
  segments(0, y, 10, y, col = "#999999", lwd = 1.2)
  y <- y - fej_mag
  segments(0, y, 10, y, col = "black", lwd = 2.5)
  tabla_teteje <- y

  # Sorok
  for (i in seq_along(sorok)) {
    y_top <- y
    y_bot <- y - sor_magassag[i]
    if (i %% 2 == 1) {
      rect(0, y_bot, oszlop_x[2], y_top, col = "#DCE8F7", border = NA)
      rect(oszlop_x[2], y_bot, 10, y_top, col = "#F9FBFD", border = NA)
    } else {
      rect(0, y_bot, oszlop_x[2], y_top, col = "#EDF3FA", border = NA)
      rect(oszlop_x[2], y_bot, 10, y_top, col = "#FFFFFF", border = NA)
    }
    for (j in 1:4) {
      sorai <- cellak[[i]][[j]]
      y_szoveg <- y_top - margo - sor_lepes / 2 - (seq_along(sorai) - 1) * sor_lepes
      text(oszlop_x[j] + margo, y_szoveg, sorai, font = fontok[j], cex = cex,
           col = if (j == 1) "#000000" else "#111111", adj = c(0, 0.5))
    }
    if (i < length(sorok)) segments(0, y_bot, 10, y_bot, col = "#D0D7DE", lwd = 1.5)
    y <- y_bot
  }

  # Függőleges elválasztók
  segments(oszlop_x[2], y, oszlop_x[2], tabla_teteje + fej_mag, col = "#CCCCCC", lwd = 1.8)
  for (x in oszlop_x[3:4]) segments(x, y, x, tabla_teteje + fej_mag, col = "#CCCCCC", lwd = 1.2)

  # Alsó záróvonal
  segments(0, y, 10, y, col = "black", lwd = 3.5)

  dev.off()
}

