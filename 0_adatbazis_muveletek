# Köztes eredmény mentése/betöltése: ha a fájl létezik, betölti, különben
# kiszámolja a kifejezést és elmenti.
gyorsitotar <- function(fajlnev, kifejezes) {
  f <- utvonal(fajlnev)
  if (file.exists(f) && !UJRASZAMOL) {
    message("Betöltés: ", f)
    return(readRDS(f))
  }
  eredmeny <- kifejezes
  saveRDS(eredmeny, f)
  eredmeny
}

