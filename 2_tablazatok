# A szavakat a cella szélességéhez igazítva tördeljük sorokba (vesszővel elválasztva)
tordel <- function(szavak, szelesseg, cex) {
  sorok <- character(0)
  aktualis <- ""
  for (szo in szavak) {
    proba <- if (aktualis == "") szo else paste0(aktualis, ", ", szo)
    if (aktualis != "" && strwidth(paste0(proba, ","), cex = cex, font = 3) > szelesseg) {
      sorok <- c(sorok, paste0(aktualis, ","))
      aktualis <- szo
    } else {
      aktualis <- proba
    }
  }
  c(sorok, aktualis)
}

