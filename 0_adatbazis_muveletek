##############################################################
#4–5. Tokenizálás, stop-szó szűrés és DFM darabonként        #
##############################################################

stm_adatok <- gyorsitotar("stm_bemenet.rds", {

  # Standard magyar és angol stop-szó lista (snowball) + grammatikai kiegészítés.
  # Az angol lista azért kell, mert a korpuszban angol nyelvű posztok és
  # idézetek is vannak.
  stop_szavak <- unique(c(stopwords("hu", source = "snowball"),
                          stopwords("en", source = "snowball"),
                          KIEGESZITO_STOP_HU))

  darab_mappa <- utvonal("dfm_darabok")
  dir.create(darab_mappa, showWarnings = FALSE)
  darabok <- darabolas(nrow(adat))

  # 1. menet: minden darabból DFM készül (lemezre mentve), közben összeadjuk a
  # szavak dokumentum-gyakoriságát (hány dokumentumban fordulnak elő).
  dokfrekv <- data.table(szo = character(), n = numeric())

  for (d in seq_along(darabok)) {
    message(sprintf("Tokenizálás: %d. darab / %d", d, length(darabok)))
    sorok <- darabok[[d]]

    # Számhoz kötőjellel kapcsolt ragok (pl. "2021-ben", "18-án", "60%-a"): a
    # számok eltávolítása után különben "ben", "án", "a" töredékek maradnának
    szoveg <- stri_replace_all_regex(adat$szoveg[sorok],
                                     "\\d+(?:[.,]\\d+)*\\s*%?-\\p{L}+", " ")
    names(szoveg) <- adat$id[sorok]

    toks <- tokens(szoveg,
                   remove_punct   = TRUE,
                   remove_numbers = TRUE,
                   remove_url     = TRUE,
                   remove_symbols = TRUE)
    rm(szoveg)

    toks <- tokens_tolower(toks)

    # Twitter/Instagram felhasználónevek (@nev): nem tartalmi elemek
    toks <- tokens_remove(toks, pattern = "@*")

    toks <- tokens_remove(toks, pattern = stop_szavak, valuetype = "fixed")

    # Tokenizálási műtermékek, nem tartalmi szűrés (lásd RAG_TOREDEKEK)
    toks <- tokens_remove(toks, pattern = RAG_TOREDEKEK, valuetype = "fixed")

    # Egybetűs maradványok (pl. a tokenizálás után megmaradt "s", "e") eltávolítása
    toks <- tokens_select(toks, min_nchar = 2)

    # Szótövesítés szándékosan NINCS (Schofield és Mimno, 2016)

    darab_dfm <- dfm(toks)
    rm(toks)

    df <- docfreq(darab_dfm)
    dokfrekv <- rbind(dokfrekv, data.table(szo = names(df), n = as.numeric(df)))
    dokfrekv <- dokfrekv[, .(n = sum(n)), by = szo]

    saveRDS(darab_dfm, file.path(darab_mappa, sprintf("darab_%03d.rds", d)))
    rm(darab_dfm, df); gc()
  }

  rm(adat, envir = globalenv()); gc()   # a szövegek innentől nem kellenek
  message("Különböző szóalakok összesen: ", nrow(dokfrekv))

  # Ritka szavak kiszűrése: a MIN_DOKFREKV-nél kevesebb dokumentumban előforduló
  # szavak (elírások, ritka tulajdonnevek és ragozott alakok) az együttes
  # előfordulási mintázatokhoz érdemben nem járulnak hozzá, viszont a
  # szókészletet és a futásidőt nagyságrendekkel növelnék. Felső küszöb
  # szándékosan nincs, a gyakori szavak mind bent maradnak.
  szokeszlet <- sort(dokfrekv[n >= MIN_DOKFREKV, szo])
  message("Szókészlet a ritka szavak kiszűrése után: ", length(szokeszlet))
  rm(dokfrekv); gc()

  # 2. menet: minden darab DFM-jét a közös szókészletre igazítjuk (azonos
  # oszlopok, azonos sorrend), majd összefűzzük.
  igazitott <- vector("list", length(darabok))
  for (d in seq_along(darabok)) {
    message(sprintf("Összefűzés: %d. darab / %d", d, length(darabok)))
    darab_dfm <- readRDS(file.path(darab_mappa, sprintf("darab_%03d.rds", d)))
    igazitott[[d]] <- dfm_match(darab_dfm, features = szokeszlet)
    rm(darab_dfm); gc()
  }
  szoveg_dfm <- do.call(rbind, igazitott)
  rm(igazitott); gc()

  # A szűrés után üresen maradt dokumentumok elhagyása
  szoveg_dfm <- dfm_subset(szoveg_dfm, ntoken(szoveg_dfm) > 0)

  # Biztonsági lépés: csak a ténylegesen előforduló szavak maradjanak
  szoveg_dfm <- dfm_trim(szoveg_dfm, min_termfreq = 1)

  stm_nyers <- convert(szoveg_dfm, to = "stm")
  azonositok <- docnames(szoveg_dfm)
  rm(szoveg_dfm); gc()

  # Metaadatok hozzárendelése azonosító alapján (a modell sorrendjében)
  stm_nyers$meta <- as.data.frame(meta_tabla[match(azonositok, id)])
  stopifnot(identical(stm_nyers$meta$id, azonositok))

  unlink(darab_mappa, recursive = TRUE)   # a darabokra már nincs szükség
  stm_nyers
})

