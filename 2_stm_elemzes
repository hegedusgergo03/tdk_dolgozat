png(utvonal("konvergencia.png"), width = 1400, height = 900, res = 150)
plot(modell$convergence$bound, type = "l",
     xlab = "EM-iteráció", ylab = "Lower bound", main = "A modell konvergenciája")
dev.off()

# Topikonként: legvalószínűbb (Highest Prob) és FREX szavak, prevalencia,
