# önállóan nem magyar szavak (pl. a "hoz" vagy a "kor" ezért NINCS a listán).
RAG_TOREDEKEK <- c("ben", "ban", "ba", "ra", "re", "ról", "ről", "ból", "ből",
                   "tól", "től", "nak", "nek", "val", "vel", "nál", "nél",
